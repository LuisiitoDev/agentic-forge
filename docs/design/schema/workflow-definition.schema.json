{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-forge.dev/schemas/workflow-definition/1.json",
  "title": "Agentic Forge workflow definition",
  "description": "Provider-neutral workflow definition, schemaVersion 1. Structural rules only; cross-reference rules (unknown steps, unreachable steps, unrouted outcomes) are enforced by WorkflowLoader / WorkflowDefinition.Validate().",
  "type": "object",
  "required": ["id", "version", "name", "start", "steps", "transitions", "schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1, "description": "Contract schema version. Readers reject any other value." },
    "id": { "$ref": "#/$defs/identifier" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])", "description": "Workflow version major.minor.patch." },
    "name": { "type": "string", "minLength": 1 },
    "start": { "$ref": "#/$defs/identifier" },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } }
  },
  "additionalProperties": true,
  "$defs": {
    "identifier": { "type": "string", "pattern": "^\\S(.*\\S)?(?![\\s\\S])" },
    "name": { "type": "string", "pattern": "^\\S(.*\\S)?(?![\\s\\S])" },
    "duration": { "type": "string", "pattern": "^([0-9]+\\.)?[0-9]{1,2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(?![\\s\\S])", "description": ".NET TimeSpan format, e.g. 00:10:00." },
    "retry": {
      "type": "object",
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1 },
        "delay": { "$ref": "#/$defs/duration" }
      },
      "additionalProperties": true
    },
    "step": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["Agent", "Tool", "Approval"] },
        "target": { "$ref": "#/$defs/identifier", "description": "Logical agent id or tool name. Never a vendor model name." },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/name" }, "uniqueItems": true },
        "allowedOutcomes": { "type": "array", "items": { "$ref": "#/$defs/name" }, "uniqueItems": true },
        "retry": { "$ref": "#/$defs/retry" },
        "timeout": { "$ref": "#/$defs/duration" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "Approval" } }, "required": ["kind"] },
          "then": {
            "not": { "anyOf": [ { "required": ["target"] }, { "required": ["capabilities"] } ] }
          },
          "else": { "required": ["target"] }
        }
      ],
      "additionalProperties": true
    },
    "transition": {
      "type": "object",
      "required": ["from", "outcome"],
      "properties": {
        "from": { "$ref": "#/$defs/identifier" },
        "outcome": { "$ref": "#/$defs/name" },
        "to": { "$ref": "#/$defs/identifier", "description": "Next step. Omitted completes the run successfully." }
      },
      "additionalProperties": true
    }
  }
}
