#!/usr/bin/env python3
"""Fake gh for the orchestrator, intake and preflight tests. State lives in the directory $FAKE_DIR, written by the
test. `--jq` filters are applied with the real jq, so the filters the scripts use are exercised too."""
import json
import os
import subprocess
import sys

D = os.environ["FAKE_DIR"]
a = sys.argv[1:]
with open(f"{D}/calls.log", "a") as f:
    f.write("gh " + " ".join(a) + "\n")
with open(f"{D}/tokens.log", "a") as f:
    f.write(os.environ.get("GH_TOKEN", "") + "\n")


def append(name, text):
    with open(f"{D}/{name}", "a") as f:
        f.write(text)


def read(name):
    with open(f"{D}/{name}") as f:
        return f.read()


def exists(name):
    return os.path.isfile(f"{D}/{name}")


if a and a[0] == "workflow":
    if os.environ.get("HANDOFF_FAIL") == "1" and "forge-orchestrator.yml" in a:
        sys.exit(1)
    append("dispatch.log", "DISPATCH " + " ".join(a) + "\n")
    sys.exit(0)

args = a[1:]
method, jqf, path, fields, i = "GET", "", "", [], 0
while i < len(args):
    x = args[i]
    if x == "-X":
        method = args[i + 1]; i += 2
    elif x == "--jq":
        jqf = args[i + 1]; i += 2
    elif x == "--paginate":
        i += 1
    elif x == "-f":
        fields.append(args[i + 1]); i += 2
    elif x == "--input":
        i += 2
    else:
        path = x; i += 1


def emit(text):
    if jqf:
        r = subprocess.run(["jq", "-r", jqf], input=text, capture_output=True, text=True)
        sys.stdout.write(r.stdout)
    else:
        sys.stdout.write(text)


def fail():
    sys.exit(1)


env = os.environ.get
key = f"{method} {path}"
if key == "GET repos/o/r/issues/12/labels":
    emit(json.dumps([{"name": n} for n in read("labels.txt").split("\n") if n]))
elif key == "POST repos/o/r/issues/12/labels":
    append("labels.txt", fields[0][len("labels[]="):] + "\n")
elif method == "DELETE" and path.startswith("repos/o/r/issues/12/labels/"):
    name = path.rsplit("/", 1)[-1]
    keep = [n for n in read("labels.txt").split("\n") if n and n != name]
    with open(f"{D}/labels.txt", "w") as f:
        f.write("".join(n + "\n" for n in keep))
elif key == "GET repos/o/r/issues/12/comments":
    # COMMENTS_FAIL_AFTER=n makes every read after the n-th fail, like an API error halfway through a run.
    n = int(read("comments.calls") or 0) if exists("comments.calls") else 0
    with open(f"{D}/comments.calls", "w") as f:
        f.write(str(n + 1))
    limit = env("COMMENTS_FAIL_AFTER", "")
    fail() if limit and n >= int(limit) else emit(read("comments.json"))
elif key == "GET repos/o/r/issues/7/comments":
    emit(read("pr_comments.json") if exists("pr_comments.json") else "[]")
elif key == "POST repos/o/r/issues/12/comments":
    append("posted.txt", fields[0][len("body="):] + "\n")
elif key == "POST repos/o/r/labels":
    pass
elif key == "POST repos/eng/forge/dispatches":
    if env("DISPATCH_FAIL", "0") == "1":
        fail()
    with open(f"{D}/dispatch_event.json", "w") as f:
        f.write(sys.stdin.read())
elif method == "GET" and path.startswith("repos/eng/forge/actions/workflows/") and "/runs?" in path:
    # Runs of one agent workflow: runs-<workflow>.json, e.g. runs-forge-ba.json. No file means no run yet.
    wf = path[len("repos/eng/forge/actions/workflows/"):].split(".yml")[0]
    emit(read(f"runs-{wf}.json") if exists(f"runs-{wf}.json") else '{"workflow_runs":[]}')
elif method == "GET" and path.startswith("repos/eng/forge/actions/runs/"):
    name = f"run-{path.rsplit('/', 1)[-1]}.json"
    emit(read(name)) if exists(name) else fail()
elif method == "GET" and path.startswith("repos/o/r/pulls?head="):
    emit(read("pulls.json"))
elif key == "GET repos/o/r/pulls/7/files":
    fail() if env("FILES_FAIL", "0") == "1" else emit(read("files.json"))
elif key == "GET repos/o/r/issues/12":
    fail() if env("REQUESTER_FAIL", "0") == "1" else emit(json.dumps({"user": {"login": env("REQUESTER", "bob")}}))
elif method == "GET" and path.startswith("users/"):
    emit(json.dumps({"type": env("USER_TYPE", "User")}))
elif method == "GET" and path.startswith("repos/o/r/collaborators/"):
    # ROLE_FAIL=1 makes every lookup after the first fail: the first is the sender check, the second the role check.
    n = int(read("role.calls")) if exists("role.calls") else 0
    with open(f"{D}/role.calls", "w") as f:
        f.write(str(n + 1))
    if env("ROLE_FAIL", "0") == "1" and n >= 1:
        fail()
    perm = env("PERM", "write")
    emit(json.dumps({"permission": perm, "role_name": env("ROLE", perm)}))
elif method == "GET" and path.startswith("repos/o/r/contents/"):
    # Files of the target, from $D/contents/<path>. A file that does not exist is a 404, like on GitHub.
    name = "contents/" + path[len("repos/o/r/contents/"):].split("?")[0]
    emit(read(name)) if exists(name) else fail()
elif method == "GET" and path.startswith("repos/eng/forge/contents/"):
    emit(read("engine-targets.json")) if exists("engine-targets.json") else fail()
elif method == "GET" and path.startswith("repos/eng/forge/actions/workflows"):
    emit(read("workflows.json")) if exists("workflows.json") else fail()
elif method == "GET" and path.startswith("repos/o/r/labels?"):
    emit(json.dumps([{"name": n} for n in read("repo-labels.txt").split("\n") if n]))
elif key == "GET repos/o/r":
    fail() if env("REPO_FAIL", "0") == "1" else emit('{"full_name":"o/r"}')
else:
    append("unhandled.log", f"UNHANDLED {method} {path}\n")
    fail()
