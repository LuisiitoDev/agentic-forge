#!/usr/bin/env bash
D="$FAKE_DIR"; echo "gh $*" >> "$D/calls.log"; echo "${GH_TOKEN:-}" >> "$D/tokens.log"
if [ "$1" = workflow ]; then echo "DISPATCH $*" >> "$D/dispatch.log"; exit 0; fi
# `gh run view <id> --log-failed`: the logs of the failed steps, from runlog-<id>.txt. No file means no log.
if [ "$1" = run ]; then f="$D/runlog-$3.txt"; if [ -f "$f" ]; then cat "$f"; exit 0; fi; exit 1; fi
shift; method=GET; jqf=""; path=""; fields=()
while [ $# -gt 0 ]; do case "$1" in -X) method="$2"; shift 2;; --jq) jqf="$2"; shift 2;; --paginate) shift;; -f) fields+=("$2"); shift 2;; --input) input="$2"; shift 2;; *) path="$1"; shift;; esac; done
emit() { if [ -n "$jqf" ]; then jq -r "$jqf"; else cat; fi; }
case "$method $path" in
  "GET repos/o/r/issues/12/labels") jq -R . < "$D/labels.txt" | jq -s 'map({name:.})' | emit ;;
  "POST repos/o/r/issues/12/labels") echo "${fields[0]#labels[]=}" >> "$D/labels.txt" ;;
  "DELETE repos/o/r/issues/12/labels/"*) l="${path##*/}"; grep -vFx -- "$l" "$D/labels.txt" > "$D/l.tmp" || true; mv "$D/l.tmp" "$D/labels.txt" ;;
  "GET repos/o/r/issues/12/comments") emit < "$D/comments.json" ;;
  "GET repos/o/r/issues/7/comments") if [ -f "$D/pr_comments.json" ]; then emit < "$D/pr_comments.json"; else echo "[]" | emit; fi ;;
  "POST repos/o/r/issues/12/comments") echo "${fields[0]#body=}" >> "$D/posted.txt" ;;
  "POST repos/o/r/labels") ;;
  "POST repos/eng/forge/dispatches") [ "${DISPATCH_FAIL:-0}" = 1 ] && exit 1; cat > "$D/dispatch_event.json" ;;
  "GET repos/eng/forge/actions/workflows/"*"/runs?"*)
    # Runs of one agent workflow: runs-<workflow>.json, e.g. runs-forge-ba.json. No file means no run yet.
    # runs-<workflow>.<n>.json, if it exists, is what the list shows after the n-th dispatch of that workflow (a retry).
    wf="${path#repos/eng/forge/actions/workflows/}"; wf="${wf%%.lock.yml*}"
    n=$(grep -c "workflow run $wf.lock.yml" "$D/dispatch.log" 2>/dev/null || true)
    if [ -f "$D/runs-$wf.$n.json" ]; then emit < "$D/runs-$wf.$n.json"
    elif [ -f "$D/runs-$wf.json" ]; then emit < "$D/runs-$wf.json"; else echo '{"workflow_runs":[]}' | emit; fi ;;
  "GET repos/eng/forge/actions/runs/"*)
    f="$D/run-${path##*/}.json"; if [ -f "$f" ]; then emit < "$f"; else exit 1; fi ;;
  "GET repos/o/r/pulls?head="*) emit < "$D/pulls.json" ;;
  "GET repos/o/r/pulls/7/files") [ "${FILES_FAIL:-0}" = 1 ] && exit 1; emit < "$D/files.json" ;;
  "GET repos/o/r/issues/12") [ "${REQUESTER_FAIL:-0}" = 1 ] && exit 1; echo "{\"user\":{\"login\":\"${REQUESTER:-bob}\"}}" | emit ;;
  "GET users/"*) echo "{\"type\":\"${USER_TYPE:-User}\"}" | emit ;;
  "GET repos/o/r/collaborators/"*)
    # ROLE_FAIL=1 makes every lookup after the first fail: the first is the sender check, the second the role check.
    n=$(cat "$D/role.calls" 2>/dev/null || echo 0); echo $((n+1)) > "$D/role.calls"
    [ "${ROLE_FAIL:-0}" = 1 ] && [ "$n" -ge 1 ] && exit 1
    echo "{\"permission\":\"${PERM:-write}\",\"role_name\":\"${ROLE:-${PERM:-write}}\"}" | emit ;;
  "GET repos/o/r/contents/"*)
    # Files of the target, from $D/contents/<path>. A file that does not exist is a 404, like on GitHub.
    f="$D/contents/${path#repos/o/r/contents/}"; f="${f%%\?*}"; if [ -f "$f" ]; then emit < "$f"; else exit 1; fi ;;
  "GET repos/eng/forge/contents/"*) if [ -f "$D/engine-targets.json" ]; then emit < "$D/engine-targets.json"; else exit 1; fi ;;
  "GET repos/eng/forge/actions/workflows"*)
    if [ -f "$D/workflows.json" ]; then emit < "$D/workflows.json"; else exit 1; fi ;;
  "GET repos/o/r/labels?"*) jq -R . < "$D/repo-labels.txt" | jq -s 'map({name:.})' | emit ;;
  "GET repos/o/r") [ "${REPO_FAIL:-0}" = 1 ] && exit 1; echo '{"full_name":"o/r"}' | emit ;;
  *) echo "UNHANDLED $method $path" >> "$D/unhandled.log"; exit 1 ;;
esac
